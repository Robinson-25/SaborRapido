# Cadena de conexión de tu base de datos Postgres (Supabase, Neon, etc.)
# En Supabase: Project Settings > Database > Connection string > "URI" (modo "Transaction")
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# Puerto donde corre la API (Render lo asigna automático, esto es para local)
PORT=4000

# Credenciales del panel admin (usuario/contraseña fijos, simples)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave

# Clave secreta para firmar el token de sesión del admin (pon algo largo y random)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Dominio de tu frontend en producción (para permitir CORS). En local no hace falta.
FRONTEND_URL=https://tu-frontend.onrender.com
